# ─── Server ─────────────────────────────────────────────────────────────
PORT=3000

# ─── Blockchain ─────────────────────────────────────────────────────────
# Get a free RPC URL from Alchemy (https://alchemy.com) or Infura
RPC_URL=your_sepolia_rpc_url_here

# Wallet private key used by the backend to sign oracle transactions.
# Use a dedicated wallet for this — never a wallet holding real funds.
PRIVATE_KEY=your_wallet_private_key_here

# Deployed DevTrust contract address (must match frontend/src/web3/constants.ts)
CONTRACT_ADDRESS=0x...

# Optional: only needed if re-running set-oracle.js against a different address
# ORACLE_ADDRESS=0x...

# ─── GitHub OAuth ───────────────────────────────────────────────────────
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback (or) https://your-service-name.onrender.com/auth/github/callback


# ─── Frontend URL (for CORS + OAuth redirect) ──────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Webhook Security ───────────────────────────────────────────────────
# Must match the secret set in GitHub repo Settings > Webhooks
WEBHOOK_SECRET=choose_your_own_secret
