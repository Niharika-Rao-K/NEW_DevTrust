# ─── DevTrust Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in your values

# WalletConnect Project ID — get one free at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# DevTrust backend URL (Member B's Express server)
# Local dev: http://localhost:3000
# Deployed (e.g. Render): https://your-app.onrender.com
VITE_BACKEND_URL=http://localhost:3000
